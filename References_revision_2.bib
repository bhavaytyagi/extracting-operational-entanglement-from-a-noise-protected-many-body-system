@misc{SM,
  note = {See Supplemental Material for the classical Gaussian phase-noise
          derivation of the dephasing channel and its normalized covariance;
          the correlated dissipator's mode decomposition and graph controls;
          protocol and numerical provenance; the pure-state negativity identity
          and the domain of the class-$\mathcal T$ growth law; eventual PPT
          for noncollective dephasing and the distinct amplitude-channel
          restrictions; conditional slow-state lifetime laws and finite-size
          calculations; the collective-dephasing fixed and peripheral spaces,
          finite-size irreducibility certificate and supported-state basin;
          the projector-state bound $E_{\mathcal N}^\infty\le\log 2L$;
          and disorder, preparation and readout analyses. It includes
          Refs.~\cite{Kribs2003,Arias2002,Bertini2019,Zanardi1997,Knill2000,
